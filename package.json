{
  "name": "poras-listening-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n rt,web -c yellow,cyan \"node server/index.mjs --port 8787\" \"vite --port 5173 --strictPort\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b",
    "model": "node tools/blender/bridge.mjs blender/build_room.py && npm run model:opt",
    "model:opt": "gltf-transform optimize blender/out/room.glb public/models/room.glb --compress meshopt --join false --flatten false --instance false --palette false --simplify false --texture-compress false"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sirv": "^3.0.2",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
